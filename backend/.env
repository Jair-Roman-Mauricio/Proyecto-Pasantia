# ═══════════════════════════════════════════════════════════════════
#  Linea 1 Metro — Variables de entorno
#  NUNCA commitear este archivo al repositorio
# ═══════════════════════════════════════════════════════════════════

# ── BASE DE DATOS ──────────────────────────────────────────────────
# OPCIÓN A: Desarrollo local (PostgreSQL en localhost)
DATABASE_URL=postgresql://postgres:12345@localhost:5432/linea1metro

# OPCIÓN B: Supabase — Conexión directa PostgreSQL
# DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# OPCIÓN C: Supabase Self-Hosted (servidores internos de la empresa)
# DATABASE_URL=postgresql://postgres:PASSWORD@SUPABASE_HOST:5432/postgres

# ── JWT ────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=9b0b6d5ee15f263bb9b2d74d588dac97e624a1dba6d0bd1b580c3fb120b6cfb8

# ── CORS ───────────────────────────────────────────────────────────
# Desarrollo local:
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
# Producción intranet (descomentar y ajustar):
# CORS_ORIGINS=["http://IP_SERVIDOR_INTRANET"]

# ── App ────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480
STORAGE_PATH=storage
MAX_IMAGE_SIZE_MB=10

# ── Solo para docker-compose --profile local (BD local) ────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
