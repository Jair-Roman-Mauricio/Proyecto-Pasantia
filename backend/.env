# ═══════════════════════════════════════════════════════════════════
#  Linea 1 Metro — Variables de entorno de producción
#  Copiar este archivo como ".env" y rellenar los valores reales
#  NUNCA commitear el .env al repositorio
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=linea1user
POSTGRES_PASSWORD=12345

# IMPORTANTE: el host debe ser "db" (nombre del servicio en docker-compose)
DATABASE_URL=postgresql://linea1user:12345@db:5432/linea1metro

# ── JWT ────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=9b0b6d5ee15f263bb9b2d74d588dac97e624a1dba6d0bd1b580c3fb120b6cfb8

# ── CORS ───────────────────────────────────────────────────────────
# Reemplazar con la IP o hostname del servidor en la intranet
# Ejemplo: ["http://192.168.1.50"] o ["http://servidor-linea1"]
CORS_ORIGINS=["http://44.203.29.225"]

# ── App ────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480
STORAGE_PATH=/app/storage
MAX_IMAGE_SIZE_MB=10
