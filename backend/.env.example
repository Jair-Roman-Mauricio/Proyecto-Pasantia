# ═══════════════════════════════════════════════════════════════════
#  Linea 1 Metro — Template de variables de entorno
#  Copiar este archivo como ".env" y ajustar los valores
#  NUNCA commitear el .env real al repositorio
# ═══════════════════════════════════════════════════════════════════

# ── BASE DE DATOS ──────────────────────────────────────────────────
# Descomenta la opción que aplique a tu entorno:

# OPCIÓN A: Desarrollo local (PostgreSQL instalado en la máquina)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/linea1metro

# OPCIÓN B: Supabase Cloud — Conexión directa PostgreSQL (Session mode, puerto 5432)
# Obtén estos datos en: Supabase Dashboard → Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres.XXXX:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# OPCIÓN C: Supabase Self-Hosted (instalado en servidores internos de la empresa)
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@IP_SERVIDOR_SUPABASE:5432/postgres

# NOTA: Al iniciar, el backend crea automáticamente todas las tablas en la BD configurada.
# No se necesita ejecutar migraciones manualmente.

# ── JWT ────────────────────────────────────────────────────────────
# Generar una clave segura con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_64_CARACTERES
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ───────────────────────────────────────────────────────────
# Desarrollo local:
#   CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
# Producción en intranet (IP o nombre del servidor donde corre el frontend):
#   CORS_ORIGINS=["http://192.168.1.50"]
#   CORS_ORIGINS=["http://servidor-linea1.intranet"]
CORS_ORIGINS=["http://localhost:5173"]

# ── Almacenamiento de imágenes ──────────────────────────────────────
# Desarrollo local: ruta relativa (se crea en backend/storage/)
STORAGE_PATH=storage
# Docker/producción: ruta absoluta dentro del contenedor
# STORAGE_PATH=/app/storage
MAX_IMAGE_SIZE_MB=10

# ── Solo para docker-compose --profile local (BD PostgreSQL local) ──
# Estas variables las usa el contenedor "db" en docker-compose.yml
# Solo son necesarias si corres docker compose --profile local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_PASSWORD
