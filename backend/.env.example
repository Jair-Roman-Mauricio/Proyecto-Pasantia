# ═══════════════════════════════════════════════════════════════════
#  Linea 1 Metro — Template de variables de entorno
#  Copiar este archivo como ".env" y ajustar los valores
#  NUNCA commitear el .env real al repositorio
# ═══════════════════════════════════════════════════════════════════

# ── BASE DE DATOS ──────────────────────────────────────────────────
# Conexión directa a PostgreSQL de Supabase (Self-Hosted o Cloud)
# Self-Hosted empresa: postgresql://postgres:TU_PASSWORD@172.19.109.49:5432/postgres
# Supabase Cloud:      postgresql://postgres.XXXX:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.XXXX:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── SUPABASE ────────────────────────────────────────────────────────
# Obtener en: Supabase Dashboard → Settings → API
# Self-Hosted: http://172.19.109.49:8000
# Supabase Cloud: https://TU_PROJECT_ID.supabase.co
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co

# Clave pública (anon key) — se usa en el frontend también
SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# Clave privada (service role key) — SOLO para el backend (crear/eliminar usuarios)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX

# JWT Secret — Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=TU_JWT_SECRET_AQUI

# ── CORS ───────────────────────────────────────────────────────────
# Desarrollo local:
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
# Producción:
# CORS_ORIGINS=["http://172.19.109.49"]

# ── Almacenamiento de imágenes ──────────────────────────────────────
STORAGE_PATH=storage
MAX_IMAGE_SIZE_MB=10

# ── Solo para docker-compose --profile local (BD PostgreSQL local) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
